{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial-explainer-thesis/v1",
  "type": "object",
  "required": [
    "question_pt_br",
    "answer_pt_br",
    "central_mechanism_pt_br",
    "mechanism_epistemic_level",
    "must_prove_claim_refs",
    "scope"
  ],
  "properties": {
    "question_pt_br": {
      "type": "string",
      "minLength": 1
    },
    "answer_pt_br": {
      "type": "string",
      "minLength": 1
    },
    "central_mechanism_pt_br": {
      "type": "string",
      "minLength": 1
    },
    "mechanism_epistemic_level": {
      "enum": [
        "DEFINITIONAL",
        "DESCRIPTIVE",
        "CORRELATIONAL",
        "PLAUSIBLE_CAUSE",
        "SUPPORTED_CAUSE"
      ]
    },
    "must_prove_claim_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "counterclaim_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    }
  },
  "additionalProperties": true
}
