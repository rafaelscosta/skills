{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/clarify/diagnosis.schema.json",
  "title": "Clarify Diagnosis Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audience",
    "outcome",
    "constraints",
    "source_model",
    "diagnosis",
    "selection"
  ],
  "properties": {
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "prior_knowledge", "context_of_use"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "prior_knowledge": {
          "type": "string",
          "enum": ["none", "low", "working", "advanced", "mixed", "unknown"]
        },
        "known_concepts": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "familiar_terms": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "likely_misconceptions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "accessibility_needs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "context_of_use": {"type": "string", "minLength": 1},
        "assumptions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "observable_behavior"],
      "properties": {
        "verb": {
          "type": "string",
          "enum": [
            "recognize",
            "locate",
            "understand",
            "remember",
            "explain",
            "compare",
            "decide",
            "execute",
            "predict",
            "detect",
            "transfer"
          ]
        },
        "observable_behavior": {"type": "string", "minLength": 1},
        "conditions": {"type": "string"},
        "unacceptable_errors": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "risk_level"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "channel": {"type": "string"},
        "time_budget": {"type": "string"},
        "desired_depth": {
          "type": "string",
          "enum": ["quick", "standard", "deep", "adaptive"]
        },
        "interactivity": {
          "type": "string",
          "enum": ["none", "one-shot", "iterative", "live", "unknown"]
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "locale": {"type": "string", "default": "pt-BR"},
        "hard_constraints": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "source_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_status", "invariants", "claims"],
      "properties": {
        "source_status": {
          "type": "string",
          "enum": ["complete", "partial", "conflicting", "unverified", "not-provided"]
        },
        "concepts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "actors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "actions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "states": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rules": {
          "type": "array",
          "items": {"type": "string"}
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "relation", "to"],
            "properties": {
              "from": {"type": "string"},
              "relation": {"type": "string"},
              "to": {"type": "string"}
            }
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "criticality"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "criticality": {
                "type": "string",
                "enum": ["supporting", "material", "critical"]
              },
              "source_evidence": {"type": "string"}
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "status"],
            "properties": {
              "statement": {"type": "string"},
              "status": {
                "type": "string",
                "enum": ["known", "inferred", "uncertain", "disputed", "out-of-scope"]
              },
              "confidence": {
                "type": "string",
                "enum": ["high", "medium", "low", "unknown"]
              },
              "basis": {"type": "string"}
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "missing_information": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_difficulty", "fidelity_risks", "success_test"],
      "properties": {
        "primary_difficulty": {"$ref": "#/$defs/difficulty"},
        "secondary_difficulties": {
          "type": "array",
          "items": {"$ref": "#/$defs/difficulty"}
        },
        "missing_prerequisites": {
          "type": "array",
          "items": {"type": "string"}
        },
        "fidelity_risks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "success_test": {"type": "string", "minLength": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "primary_technique", "validation_method"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["quick", "standard", "deep", "flow", "compare", "audit", "visual", "high-risk"]
        },
        "primary_technique": {"type": "string", "minLength": 1},
        "supporting_techniques": {
          "type": "array",
          "maxItems": 6,
          "items": {"type": "string"}
        },
        "techniques_rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["technique", "reason"],
            "properties": {
              "technique": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "validation_method": {"type": "string", "minLength": 1},
        "stop_criteria": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity", "evidence"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "lexical",
            "terminological",
            "syntactic",
            "semantic",
            "conceptual",
            "causal",
            "structural",
            "procedural",
            "decisional",
            "numerical",
            "visual-relational",
            "epistemic",
            "contextual-pragmatic",
            "cognitive-load",
            "motivational-relevance",
            "accessibility"
          ]
        },
        "severity": {"type": "integer", "minimum": 0, "maximum": 3},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    }
  }
}
